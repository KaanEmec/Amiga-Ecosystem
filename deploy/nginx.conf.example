# nginx alternative; obtain certificates with certbot. Replace the domain.
server {
    listen 443 ssl http2;
    server_name amiga.example.org;
    ssl_certificate     /etc/letsencrypt/live/amiga.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/amiga.example.org/privkey.pem;
    gzip on; gzip_types application/json text/css application/javascript;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
server { listen 80; server_name amiga.example.org; return 301 https://$host$request_uri; }
