# Copy to /etc/amiga/amiga.env (chmod 600, owned by root). Never commit real values.
AMIGA_ENV=production
AMIGA_ADDR=127.0.0.1:8080
AMIGA_DATA_DIR=/var/lib/amiga
AMIGA_BASE_URL=https://amiga.example.org
# Behind the reverse proxy: take the client IP from X-Forwarded-For (rate limits, login throttle, Turnstile)
AMIGA_TRUST_PROXY=1
# Behind Cloudflare: read the client IP from this header instead (the last X-Forwarded-For hop is a Cloudflare edge)
# AMIGA_CLIENT_IP_HEADER=CF-Connecting-IP
# 32+ random bytes, hex: openssl rand -hex 32
AMIGA_SECRET=
# Cloudflare Turnstile keys for the real domain (required in production)
AMIGA_TURNSTILE_SITE_KEY=
AMIGA_TURNSTILE_SECRET=
# Seed files used once, when the database is empty
AMIGA_SEED_JSON=/opt/amiga/data/amiga-data.json
AMIGA_SEED_IMAGES=/opt/amiga/images
